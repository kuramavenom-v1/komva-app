<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard - Komva</title>
    <link rel="stylesheet" href="css/variables.css">
    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="css/dashboard.css">
    <link rel="stylesheet" href="css/chat.css">
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="user-profile-preview">
                    <img src="https://i.pravatar.cc/150?img=8" alt="Avatar" class="avatar">
                    <div>
                        <h4 id="current-username">John Doe</h4>
                        <span class="status-indicator online">● Online</span>
                    </div>
                </div>
                <div class="sidebar-actions">
                    <a href="settings.html" title="Settings">⚙️</a>
                    <button id="logout-btn" title="Logout">🚪</button>
                </div>
            </div>

            <div class="search-box">
                <input type="text" id="search-users" placeholder="Search users or messages...">
            </div>

            <div class="conversations-list" id="conversations-container">
                <!-- Dynamic Conversations will load here -->
            </div>
        </aside>

        <!-- Chat Area -->
        <main class="chat-area" id="chat-area">
            <div class="empty-state">
                <h3>Select a conversation</h3>
                <p>Choose a conversation from the sidebar to start messaging.</p>
            </div>
        </main>
    </div>

    <script src="js/mock-data.js"></script>
    <script src="js/storage.js"></script>
    <script src="js/chat.js"></script>
    <script src="js/app.js"></script>
</body>
</html>
