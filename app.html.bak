<!DOCTYPE html>
<html lang="en" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Komva - Messenger</title>
    <link rel="stylesheet" href="css/variables.css">
    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="css/dashboard.css">
    <link rel="stylesheet" href="css/chat.css">
    <style>
        /* Bottom Floating Navigation Bar */
        .bottom-nav {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            background-color: #17212b;
            border: 1px solid #232e3c;
            display: flex;
            align-items: center;
            justify-content: space-around;
            padding: 8px 16px;
            border-radius: 40px;
            width: 90%;
            max-width: 450px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            z-index: 1000;
        }

        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            background: none;
            border: none;
            color: #879097;
            cursor: pointer;
            font-size: 0.75rem;
            gap: 4px;
            transition: 0.2s;
        }

        .nav-item.active {
            color: #52b8ff;
        }

        .nav-item.active .nav-icon-bg {
            background-color: #2b5278;
            color: #fff;
        }

        .nav-icon-bg {
            width: 38px;
            height: 38px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            position: relative;
        }

        .nav-badge {
            position: absolute;
            top: -2px;
            right: -2px;
            background-color: #2481cc;
            color: white;
            font-size: 0.6rem;
            padding: 2px 5px;
            border-radius: 10px;
        }

        /* App Views Container */
        .app-view {
            display: none;
            height: calc(100vh - 90px);
            overflow-y: auto;
            padding-bottom: 30px;
        }
        .app-view.active-view {
            display: block;
        }

        /* Profile View Styling (Matches your image) */
        .profile-view-container {
            max-width: 600px;
            margin: 20px auto;
            padding: 20px;
            color: #fff;
        }
        .profile-header-card {
            text-align: center;
            padding: 20px 0;
        }
        .profile-big-avatar {
            width: 100px;
            height: 100px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #2481cc;
            margin-bottom: 10px;
        }
        .profile-actions-row {
            display: flex;
            gap: 10px;
            justify-content: center;
            margin: 20px 0;
        }
        .profile-action-btn {
            background-color: #17212b;
            border: 1px solid #232e3c;
            color: #fff;
            padding: 10px 20px;
            border-radius: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            cursor: pointer;
        }
        .profile-info-box {
            background-color: #17212b;
            border: 1px solid #232e3c;
            border-radius: 16px;
            padding: 15px 20px;
            margin-bottom: 15px;
        }
        .info-item {
            margin-bottom: 15px;
        }
        .info-item:last-child {
            margin-bottom: 0;
        }
        .info-value {
            font-size: 1rem;
            font-weight: 600;
            color: #fff;
        }
        .info-label {
            font-size: 0.8rem;
            color: #879097;
            margin-top: 2px;
        }
    </style>
</head>
<body style="background-color: #0e1621; color: #fff;">

    <!-- 1. شاشة المحادثات (Chats View) -->
    <div id="view-chats" class="app-view active-view">
        <div style="padding: 20px;">
            <h2>المحادثات</h2>
            <div class="search-box" style="margin: 15px 0;">
                <input type="text" id="search-users" placeholder="بحث عن محادثات أو مستخدمين..." style="width:100%; padding:12px; border-radius:15px; background:#17212b; border:1px solid #232e3c; color:#fff;">
            </div>
            <div id="conversations-container">
                <!-- المحادثات التجريبية -->
            </div>
        </div>
    </div>

    <!-- 2. شاشة جهات الاتصال (Contacts View) -->
    <div id="view-contacts" class="app-view">
        <div style="padding: 20px;">
            <h2>جهات الاتصال</h2>
            <p style="color: #879097; margin-top: 10px;">قريباً يتم عرض جميع المستخدمين المتاحين للمراسلة.</p>
        </div>
    </div>

    <!-- 3. شاشة الإعدادات (Settings View) -->
    <div id="view-settings" class="app-view">
        <div style="padding: 20px; max-width:600px; margin:0 auto;">
            <h2>الإعدادات</h2>
            <div style="background:#17212b; border:1px solid #232e3c; border-radius:16px; padding:20px; margin-top:20px;">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                    <span>الوضع الليلي التلقائي</span>
                    <input type="checkbox" checked id="settings-theme-toggle">
                </div>
                <div style="display:flex; justify-content:space-between; align-items:center;">
                    <span>الإشعارات الصوتية</span>
                    <input type="checkbox" checked>
                </div>
            </div>
            <button onclick="logout()" style="width:100%; background:#ef4444; color:white; padding:12px; border-radius:12px; border:none; margin-top:20px; font-weight:bold; cursor:pointer;">تسجيل الخروج</button>
        </div>
    </div>

    <!-- 4. شاشة الملف الشخصي (Profile View - المطابقة لصورتك تماماً) -->
    <div id="view-profile" class="app-view">
        <div class="profile-view-container">
            <div class="profile-header-card">
                <img src="https://i.pravatar.cc/150?img=8" class="profile-big-avatar" id="user-profile-img">
                <h2 id="profile-display-name" style="font-size: 1.4rem; font-weight: 700;">Devil's Venom</h2>
                <span style="font-size: 0.85rem; color: #22c55e;">متصل</span>
            </div>

            <div class="profile-actions-row">
                <button class="profile-action-btn">📷 تعيين صورة</button>
                <button class="profile-action-btn">✏️ تعديل البيانات</button>
                <button class="profile-action-btn" onclick="switchTab('view-settings')">⚙️ الإعدادات</button>
            </div>

            <div class="profile-info-box">
                <div class="info-item">
                    <div class="info-value">+20 112 0207758</div>
                    <div class="info-label">جوال</div>
                </div>
                <div class="info-item" style="margin-top: 15px;">
                    <div class="info-value" id="profile-bio-text">Devil's Warth — Be the leader, not the follower...</div>
                    <div class="info-label">النبذة</div>
                </div>
                <div class="info-item" style="margin-top: 15px;">
                    <div class="info-value" id="profile-username-text">@V_K_U1</div>
                    <div class="info-label">اسم المستخدم</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Floating Navigation Bar -->
    <nav class="bottom-nav">
        <button class="nav-item active" onclick="switchTab('view-chats', this)">
            <div class="nav-icon-bg">
                💬
                <span class="nav-badge">138</span>
            </div>
            <span>المحادثات</span>
        </button>
        <button class="nav-item" onclick="switchTab('view-contacts', this)">
            <div class="nav-icon-bg">👤</div>
            <span>جهات الاتصال</span>
        </button>
        <button class="nav-item" onclick="switchTab('view-settings', this)">
            <div class="nav-icon-bg">⚙️</div>
            <span>الإعدادات</span>
        </button>
        <button class="nav-item" onclick="switchTab('view-profile', this)">
            <div class="nav-icon-bg" style="padding:0;">
                <img src="https://i.pravatar.cc/150?img=8" style="width:100%; height:100%; border-radius:50%; object-fit:cover;">
            </div>
            <span>الملف الشخصي</span>
        </button>
    </nav>

    <script src="js/storage.js"></script>
    <script src="js/mock-data.js"></script>
    <script src="js/chat.js"></script>
    <script>
        // Tab Navigation Logic
        function switchTab(viewId, btnElement) {
            document.querySelectorAll('.app-view').forEach(view => {
                view.classList.remove('active-view');
            });
            document.getElementById(viewId).classList.add('active-view');

            if (btnElement) {
                document.querySelectorAll('.nav-item').forEach(item => {
                    item.classList.remove('active');
                });
                btnElement.classList.add('active');
            }
        }

        function logout() {
            Storage.clearSession();
            window.location.href = 'login.html';
        }
    </script>
</body>
</html>
