<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Komva - Telegram Style</title>
    <link rel="stylesheet" href="css/variables.css">
    <link rel="stylesheet" href="css/global.css">
    <link rel="stylesheet" href="css/dashboard.css">
    <link rel="stylesheet" href="css/chat.css">
</head>
<body>
    <div class="app-container">
        <!-- Sidebar -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <button class="menu-btn" id="burger-menu" title="Menu">☰</button>
                <div class="search-box" style="flex: 1; padding: 0;">
                    <input type="text" id="search-users" placeholder="Search">
                </div>
            </div>

            <!-- Stories Row -->
            <div class="stories-container" id="stories-container">
                <div class="story-item" id="add-story-btn">
                    <div class="story-ring add-story">
                        <span style="font-size: 1.5rem; color: var(--tg-primary);">+</span>
                    </div>
                    <span>My Story</span>
                </div>
                <!-- Mock Stories -->
                <div class="story-item">
                    <div class="story-ring"><img src="https://i.pravatar.cc/150?img=1"></div>
                    <span>Ahmed</span>
                </div>
                <div class="story-item">
                    <div class="story-ring"><img src="https://i.pravatar.cc/150?img=5"></div>
                    <span>Sara</span>
                </div>
            </div>

            <!-- Conversations List -->
            <div class="conversations-list" id="conversations-container">
                <!-- Dynamically loaded chats -->
            </div>
        </aside>

        <!-- Chat Area -->
        <main class="chat-area" id="chat-area">
            <div class="empty-state">
                <h3>Select a chat to start messaging</h3>
            </div>
        </main>
    </div>

    <!-- Telegram-style Slide-out Menu Modal / Drawer -->
    <div id="tg-menu-drawer" style="display:none; position:fixed; top:0; left:0; width:300px; height:100%; background:var(--tg-sidebar-bg); z-index:100; box-shadow:5px 0 15px rgba(0,0,0,0.3); padding:20px; border-right:1px solid var(--tg-border);">
        <div style="display:flex; align-items:center; gap:15px; margin-bottom:30px;">
            <img src="https://i.pravatar.cc/150?img=8" class="avatar" style="width:60px; height:60px; border-radius:50%;">
            <div>
                <h3 id="menu-user-name">John Doe</h3>
                <span style="font-size:0.85rem; color:var(--tg-secondary);" id="menu-user-phone">@johndoe</span>
            </div>
        </div>
        <ul style="list-style:none; display:flex; flex-direction:column; gap:15px;">
            <li><a href="profile.html" style="display:flex; gap:15px; align-items:center; font-weight:500;">👤 My Profile</a></li>
            <li><a href="settings.html" style="display:flex; gap:15px; align-items:center; font-weight:500;">⚙️ Settings</a></li>
            <li><a href="#" id="menu-dark-toggle" style="display:flex; gap:15px; align-items:center; font-weight:500;">🌙 Toggle Theme</a></li>
            <li><hr style="border:0; border-top:1px solid var(--tg-border); margin:10px 0;"></li>
            <li><a href="#" id="menu-logout" style="display:flex; gap:15px; align-items:center; color:#ef4444; font-weight:500;">🚪 Log Out</a></li>
        </ul>
        <button id="close-menu" style="position:absolute; top:20px; right:20px; background:none; border:none; font-size:1.2rem; cursor:pointer; color:var(--tg-secondary);">✕</button>
    </div>

    <script src="js/storage.js"></script>
    <script src="js/mock-data.js"></script>
    <script src="js/chat.js"></script>
    <script>
        // Drawer Menu Script
        const burgerMenu = document.getElementById('burger-menu');
        const tgMenuDrawer = document.getElementById('tg-menu-drawer');
        const closeMenu = document.getElementById('close-menu');
        const menuDarkToggle = document.getElementById('menu-dark-toggle');
        const menuLogout = document.getElementById('menu-logout');

        burgerMenu.addEventListener('click', () => {
            tgMenuDrawer.style.display = 'block';
        });
        closeMenu.addEventListener('click', () => {
            tgMenuDrawer.style.display = 'none';
        });
        menuDarkToggle.addEventListener('click', (e) => {
            e.preventDefault();
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            Storage.setTheme(next);
        });
        menuLogout.addEventListener('click', (e) => {
            e.preventDefault();
            Storage.clearSession();
            window.location.href = 'login.html';
        });

        // Add story mock interaction
        document.getElementById('add-story-btn').addEventListener('click', () => {
            alert("Story feature simulation: Story uploaded successfully!");
        });
    </script>
</body>
</html>
